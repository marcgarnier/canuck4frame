# Canuck4Frame environment variables
#
# The default data-collection backend is the GDELT DOC 2.0 API, which is FREE
# and requires NO API key. You can run the whole pipeline without setting
# anything here.
#
# Copy this file to `.env` and fill in values only if you enable an optional
# backend (e.g. Media Cloud) in config.yaml.

# Optional: Media Cloud API key (https://search.mediacloud.org/) — only needed
# if you switch data_source.backend to "mediacloud" in config.yaml.
MEDIACLOUD_API_KEY=

# Optional: custom User-Agent used when fetching article bodies. Be polite and
# identify your research project + a contact address.
SCRAPER_USER_AGENT=Canuck4Frame research bot (+mailto:you@example.com)
